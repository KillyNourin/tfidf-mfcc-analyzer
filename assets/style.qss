/* Pitch Black (#0A0A0A) + Matte Charcoal (#121212) + Acid Yellow (#EAFF00)*/

/* Latar belakang utama Pitch Black */
QMainWindow, QWidget#CentralWidget {
    background-color: #0A0A0A;
    color: #F5F5F5;
    font-family: "Helvetica Neue", "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
}

/* Header Kartu Hitam Matte dengan Garis Tepi Tipis */
QFrame#HeaderCard {
    background-color: #121212;
    border: 1px solid #242424;
    border-radius: 12px;
}

QLabel#HeaderBadge {
    background-color: rgba(234, 255, 0, 0.12);
    color: #EAFF00;
    border: 1px solid rgba(234, 255, 0, 0.35);
    border-radius: 10px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 0.5px;
}

QLabel#HeaderTitle {
    color: #FFFFFF;
    font-size: 21px;
    font-weight: bold;
}

QLabel#HeaderSubtitle {
    color: #8E8E8E;
    font-size: 13px;
}

/* Kartu Panel Konten */
QFrame#PanelCard {
    background-color: #121212;
    border: 1px solid #242424;
    border-radius: 12px;
}

QLabel#SectionTitle {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: bold;
    padding-bottom: 6px;
    border-bottom: 1px solid #222222;
}

QLabel#SectionDesc {
    color: #8E8E8E;
    font-size: 12px;
}

QLabel#FieldLabel {
    color: #D4D4D4;
    font-weight: 600;
    font-size: 12px;
    margin-top: 4px;
}

/* Tab Navigasi Kapsul Gelap & Neon Yellow */
QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabBar::tab {
    background-color: #141414;
    color: #8E8E8E;
    padding: 9px 22px;
    margin-right: 8px;
    border: 1px solid #262626;
    border-radius: 17px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #EAFF00;
    color: #0A0A0A;
    border: 1px solid #EAFF00;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background-color: #1E1E1E;
    color: #FFFFFF;
    border: 1px solid #383838;
}

/* Kotak Input, Dropdown, SpinBox */
QComboBox, QSpinBox, QTextEdit {
    background-color: #0D0D0D;
    color: #F5F5F5;
    border: 1px solid #2A2A2A;
    border-radius: 8px;
    padding: 7px 10px;
    selection-background-color: #EAFF00;
    selection-color: #0A0A0A;
}

QComboBox:focus, QSpinBox:focus, QTextEdit:focus {
    background-color: #141414;
    border: 1px solid #EAFF00;
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox QAbstractItemView {
    background-color: #161616;
    color: #F5F5F5;
    border: 1px solid #2E2E2E;
    border-radius: 8px;
    selection-background-color: #EAFF00;
    selection-color: #0A0A0A;
}

/* Tombol Utama (Neon Acid-Yellow Pill CTA khas Alphamark) */
QPushButton#PrimaryButton {
    background-color: #EAFF00;
    color: #0A0A0A;
    border: 1px solid #EAFF00;
    border-radius: 19px;
    padding: 11px 18px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton#PrimaryButton:hover {
    background-color: #F4FF66;
    border: 1px solid #F4FF66;
}

QPushButton#PrimaryButton:pressed {
    background-color: #CFE000;
}

/* Tombol Sekunder (Dark Studio Pill Button) */
QPushButton#SecondaryButton {
    background-color: #181818;
    color: #F5F5F5;
    border: 1px solid #2E2E2E;
    border-radius: 17px;
    padding: 8px 14px;
    font-weight: 600;
}

QPushButton#SecondaryButton:hover {
    background-color: #222222;
    border: 1px solid #EAFF00;
    color: #EAFF00;
}

QPushButton#SecondaryButton:pressed {
    background-color: #0F0F0F;
}

QPushButton#SecondaryButton:disabled {
    background-color: #111111;
    color: #4A4A4A;
    border: 1px solid #1E1E1E;
}

/* Tabel Data Grid Gelap */
QTableWidget {
    background-color: #0D0D0D;
    color: #EAEAEA;
    gridline-color: #222222;
    border: 1px solid #242424;
    border-radius: 8px;
}

QTableWidget::item:selected {
    background-color: #EAFF00;
    color: #0A0A0A;
}

QHeaderView::section {
    background-color: #161616;
    color: #EAFF00;
    font-weight: bold;
    padding: 7px;
    border: none;
    border-bottom: 1px solid #2A2A2A;
}

QTableWidget QTableCornerButton::section {
    background-color: #161616;
    border: none;
}

/* ScrollArea & Scrollbar Gelap */
QScrollArea,
QScrollArea > QWidget > QWidget,
QAbstractScrollArea::corner {
    background-color: transparent;
    border: none;
}

QScrollBar:vertical {
    background: #0D0D0D;
    width: 7px;
    margin: 4px 1px 4px 1px;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: #2E2E2E;
    min-height: 28px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: #EAFF00;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Dialog Peringatan / Error Tema Gelap */
QMessageBox {
    background-color: #141414;
    color: #F5F5F5;
}

QMessageBox QLabel {
    color: #F5F5F5;
}

QMessageBox QPushButton {
    background-color: #EAFF00;
    color: #0A0A0A;
    border-radius: 12px;
    padding: 6px 16px;
    font-weight: bold;
}